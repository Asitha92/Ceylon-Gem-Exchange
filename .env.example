# Local dev only — copy to .env. Not used for staging/prod (those use real
# managed services and Secrets Manager, per the Phase 0 sequencing decision).

POSTGRES_USER=ceylon_gems
POSTGRES_PASSWORD=ceylon_gems_dev
POSTGRES_DB=ceylon_gems
# 55432, not 5432 — avoids colliding with a native/system Postgres install
POSTGRES_PORT=55432

REDIS_PORT=6379

TYPESENSE_API_KEY=ceylon_gems_dev_key
TYPESENSE_PORT=8108

MINIO_ROOT_USER=ceylon_gems
MINIO_ROOT_PASSWORD=ceylon_gems_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Clerk (Development instance, from dashboard.clerk.com → API Keys) —
# apps/api only, never exposed to clients
CLERK_SECRET_KEY=
# From the webhook endpoint you create in the Clerk dashboard (Svix signing secret)
CLERK_WEBHOOK_SIGNING_SECRET=
